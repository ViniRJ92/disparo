{
  "name": "disparo",
  "version": "0.1.0",
  "description": "Disparo: gerenciamento de múltiplas linhas de WhatsApp (1 a 10) com controle global e individual.",
  "author": "Vinicius Braga",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "node --watch --disable-warning=ExperimentalWarning src/server/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node --disable-warning=ExperimentalWarning src/server/main.ts",
    "typecheck:server": "tsc -p tsconfig.json",
    "typecheck:web": "tsc -p web/tsconfig.json",
    "typecheck": "npm run typecheck:server && npm run typecheck:web",
    "test": "node --disable-warning=ExperimentalWarning --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.5",
    "lucide-react": "^1.46.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
